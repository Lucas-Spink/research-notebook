{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "type": {
                "type": "string",
                "const": "artefact"
              },
              "experiment_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "artefact_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": {}
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "type",
              "experiment_id",
              "artefact_id",
              "version",
              "position",
              "size"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "type": {
                "type": "string",
                "const": "note"
              },
              "text": {
                "type": "string"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": {}
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "type",
              "text",
              "position",
              "size"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "type": {
                "type": "string",
                "const": "region"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": {}
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "position",
              "size"
            ],
            "additionalProperties": {}
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "label": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "derived-from",
              "related-to",
              "requires-investigation"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ],
        "additionalProperties": {}
      }
    },
    "viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "format_version",
    "id",
    "name",
    "nodes",
    "edges",
    "viewport"
  ],
  "additionalProperties": {},
  "title": "*.canvas.json (format version 2)",
  "description": "Structural constraints only. Cross-entry and cross-file rules are listed in docs/format/format-v1.md."
}
