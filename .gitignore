# .gitignore for the Research Notebook application repository
#
# Always committed (do not add ignore rules for these):
#   pnpm-lock.yaml, apps/desktop/src-tauri/Cargo.lock    reproducible builds
#   apps/desktop/src/ipc/                                generated bindings; CI checks for drift
#   docs/format/schemas/                                 generated JSON Schemas
#   **/proptest-regressions/, **/__golden__/            regression seeds and golden files
#   fixtures/projects/ (except generated ones below)     compatibility fixtures, including evidence files
#   .claude/settings.json, .claude/commands/            shared agent configuration

# ── Node and TypeScript ─────────────────────────────
node_modules/
.pnpm-store/
dist/
build/
out/
*.tsbuildinfo
.eslintcache
coverage/

# ── Rust and Tauri ──────────────────────────────────
target/
apps/desktop/src-tauri/gen/schemas/
mutants.out/
mutants.out.old/

# ── Test, benchmark and mutation output ─────────────
reports/
.stryker-tmp/
apps/desktop/e2e/output/
/bench-results*.json
/tmp/
/.tmp/

# Generated by `pnpm fixtures:generate`; never committed
fixtures/projects/*/large/

# ── VS Code extension ───────────────────────────────
extensions/vscode/.vscode-test/
*.vsix

# ── Secrets and signing material ────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.provisionprofile
*.mobileprovision

# ── Logs ────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
# Preview fixtures include .log files on purpose
!fixtures/**/*.log

# ── Operating system clutter ────────────────────────
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editors ─────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
# VS Code Local History extension; anchored so fixture _notebook/.history folders are not affected
/.history/

# ── AI tools (personal, not shared) ─────────────────
.claude/settings.local.json
CLAUDE.local.md
