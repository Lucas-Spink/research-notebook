# .gitignore template for a research project folder managed by Research Notebook
# Copy to the project root as .gitignore. The app appends the notebook section itself
# when it creates a project (spec 5.12); it is included here for projects set up by hand.

# ── Research Notebook (spec 5.12) ───────────────────
_notebook/.lock
_notebook/.history/
_notebook/.trash/
_notebook/inbox/
_notebook/backups/
# Captured evidence and scripts: delete these two lines if capture.evidence_in_git is true,
# or track them with Git LFS instead
_notebook/experiments/*/evidence/
_notebook/experiments/*/methods/
# Exports are regenerated by the archive step
_notebook/exports/

# ── Data and large outputs (keep raw data out of git) ─
data/raw/
*.bam
*.bai
*.cram
*.fastq
*.fastq.gz
*.fq.gz
*.h5
*.h5ad
*.loom
*.rds
*.RData

# ── Workflow managers ───────────────────────────────
.snakemake/
.nextflow/
.nextflow.log*
work/

# ── R ───────────────────────────────────────────────
.Rhistory
.Rproj.user/
renv/library/
renv/staging/

# ── Python and Jupyter ──────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# ── Operating system and editors ────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
