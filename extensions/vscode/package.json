{
  "name": "research-notebook-vscode",
  "displayName": "Research Notebook",
  "description": "Add a file from the workspace to a Research Notebook experiment as evidence or a method.",
  "version": "0.1.4",
  "private": true,
  "publisher": "research-notebook",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/bundle.js",
  "contributes": {
    "commands": [
      {
        "command": "researchNotebook.addFileToExperiment",
        "title": "Research Notebook: Add file to experiment",
        "category": "Research Notebook"
      },
      {
        "command": "researchNotebook.addAsResult",
        "title": "Add to STRATA as result",
        "category": "Research Notebook"
      },
      {
        "command": "researchNotebook.addAsMethod",
        "title": "Add to STRATA as method",
        "category": "Research Notebook"
      },
      {
        "command": "researchNotebook.addAsLink",
        "title": "Add to STRATA as link (no copy)",
        "category": "Research Notebook"
      },
      {
        "command": "researchNotebook.chooseDropMode",
        "title": "Choose what dropped files are added as",
        "category": "Research Notebook",
        "icon": "$(settings-gear)"
      },
      {
        "command": "researchNotebook.refreshView",
        "title": "Refresh the STRATA view",
        "category": "Research Notebook",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "researchNotebook.addAsResult",
          "when": "resourceScheme == file",
          "group": "researchNotebook@0"
        },
        {
          "command": "researchNotebook.addAsMethod",
          "when": "resourceScheme == file",
          "group": "researchNotebook@1"
        },
        {
          "command": "researchNotebook.addAsLink",
          "when": "resourceScheme == file",
          "group": "researchNotebook@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "researchNotebook.addAsResult",
          "when": "resourceScheme == file",
          "group": "researchNotebook@0"
        },
        {
          "command": "researchNotebook.addAsMethod",
          "when": "resourceScheme == file",
          "group": "researchNotebook@1"
        },
        {
          "command": "researchNotebook.addAsLink",
          "when": "resourceScheme == file",
          "group": "researchNotebook@2"
        }
      ],
      "view/title": [
        {
          "command": "researchNotebook.chooseDropMode",
          "when": "view == researchNotebook.projectView",
          "group": "navigation@1"
        },
        {
          "command": "researchNotebook.refreshView",
          "when": "view == researchNotebook.projectView",
          "group": "navigation@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "researchNotebook.projectView",
          "name": "STRATA"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "researchNotebook.projectView",
        "contents": "No Research Notebook project found. Open a project in STRATA, or add a project folder (one with _notebook/project.yaml in it) to this workspace."
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/bundle.js",
    "test": "vitest run --root ../.. --project unit extensions/vscode"
  },
  "dependencies": {
    "@research-notebook/format": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/vscode": "1.138.0",
    "esbuild": "0.28.2"
  }
}
